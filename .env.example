# ──────────────────────────────────────────────────────────────
# Server — copy to .env and fill in real values
# ──────────────────────────────────────────────────────────────

# PostgreSQL connection string (required)
# Local:  postgresql://user:password@localhost:5432/dbname
# Neon:   postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Anthropic API key — required for the PCB (Podcast Content Browser) feature
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API key — optional, enables Gemini as an alternative AI provider for transcript analysis
GEMINI_API_KEY=

# Resend API key — required for the contact form email sending
RESEND_API_KEY=

# Supadata API key — required for YouTube transcript extraction (supadata.ai)
SUPADATA_API_KEY=

# Voyage AI API key — required for real-time RAG embeddings on new episodes (voyage-3, 1024 dims)
VOYAGE_API_KEY=

# Port the Express server listens on (default: 5000)
PORT=5000

# ──────────────────────────────────────────────────────────────
# Social Media Manager — optional (Phase 7: video teaser generation)
# ──────────────────────────────────────────────────────────────

# Redis connection URL — required for video teaser BullMQ queue
REDIS_URL=redis://localhost:6379

# Local path for uploaded media images (default: ./uploads/media)
MEDIA_STORAGE_PATH=./uploads/media

# Local path for uploaded/generated videos (default: ./uploads/videos)
VIDEO_STORAGE_PATH=./uploads/videos

# Maximum upload size in MB for video files (informational, not enforced here)
MAX_UPLOAD_SIZE_MB=4000

# ──────────────────────────────────────────────────────────────
# Client (Vite) — prefix with VITE_ so Vite exposes them to the browser
# ──────────────────────────────────────────────────────────────

# Full URL of the API server.  Leave empty for local dev (Vite proxy handles it).
# In production (Netlify), set this to your Render backend URL.
# Example: https://media-navigator.onrender.com
VITE_API_URL=
